{
  "name": "militia-mayhem-rework",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*\" \"tools/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*\" \"tools/**/*.mjs\"",
    "lint": "node tools/lint.mjs",
    "test": "node --test \"tests/**/*.test.*\"",
    "smoke": "node tools/smoke.mjs",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
